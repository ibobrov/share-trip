@startuml
title Конфигурация и секреты ShareTrip
top to bottom direction
skinparam shadowing false
skinparam defaultFontName Arial
skinparam rectangleBackgroundColor #F3F4F6
skinparam rectangleBorderColor #6B7280
skinparam ArrowColor #374151

together {
  rectangle "ConfigMap\nsharetrip-config" as tripConfig
  rectangle "Secret\nsharetrip-secret" as tripSecret
  rectangle "ConfigMap\ncontract-config" as contractConfig
  rectangle "Secret\ncontract-secret" as contractSecret
  rectangle "ConfigMap\nnotification-config" as notificationConfig
  rectangle "Secret\nnotification-secret" as notificationSecret
}

rectangle "Deployment\nsharetrip" as trip
rectangle "Deployment\ncontract" as contract
rectangle "Deployment\nnotification" as notification

tripConfig -[hidden]right-> tripSecret
tripSecret -[hidden]right-> contractConfig
contractConfig -[hidden]right-> contractSecret
contractSecret -[hidden]right-> notificationConfig
notificationConfig -[hidden]right-> notificationSecret

tripConfig -down-> trip : env
tripSecret -down-> trip : env
contractConfig -down-> contract : env
contractSecret -down-> contract : env
notificationConfig -down-> notification : env
notificationSecret -down-> notification : env
@enduml
