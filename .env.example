# Local development only. Copy to .env and replace placeholders.
DATABASE_DSN=postgres://postgres:<password>@localhost:6543/sharetrip?sslmode=disable
KEYCLOAK_CLIENT_SECRET=<keycloak-client-secret>

# Runtime configuration
HTTP_PORT=8080
APP_ENV=local
LOG_LEVEL=INFO
CONTRACT_SERVICE_URL=http://localhost:4002
KAFKA_BROKERS=localhost:9092
KAFKA_TRIP_TOPIC=trip.events
REQUEST_TIMEOUT_MS=2000
CONTRACT_REQUEST_TIMEOUT_MS=500
CONTRACT_CHECK_TIMEOUT_MS=1200
RETRY_ATTEMPTS=2
RETRY_DELAY_MS=100
KAFKA_PUBLISH_TIMEOUT_MS=1000
KAFKA_PUBLISH_ATTEMPTS=3
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_TIMEOUT_MS=15000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=10
KEYCLOAK_ISSUER=http://localhost:8087/realms/sharetrip
KEYCLOAK_CLIENT_ID=sharetrip-api
KEYCLOAK_TIMEOUT_MS=5000
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:14319

# Local Docker Compose and migrations
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<password>
POSTGRES_DB=sharetrip
POSTGRES_PORT=6543
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=${DATABASE_DSN}
POSTGRES_EXPORTER_PASSWORD=<exporter-password>
