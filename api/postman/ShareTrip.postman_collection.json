  "info": {
    "name": "ShareTrip — All APIs",
    "description": "ShareTrip, Contract, Notification and Keycloak. Kubernetes localhost URLs. Read api/postman/README.md before running. Secrets are intentionally empty. Trip endpoints require X-Refresh-Token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 Keycloak",
      "item": [
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token issued', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const t = pm.response.json();",
                  "  pm.test('Tokens present', () => { pm.expect(t.access_token).to.be.a('string').and.not.empty; pm.expect(t.refresh_token).to.be.a('string').and.not.empty; });",
                  "  if (t.access_token) pm.collectionVariables.set('access_token', t.access_token);",
                  "  if (t.refresh_token) pm.collectionVariables.set('refresh_token', t.refresh_token);",
                  "  if (t.access_token) {",
                  "    const p = t.access_token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "    const claims = JSON.parse(atob(p));",
                  "    if (claims.company_id) pm.collectionVariables.set('company_id', claims.company_id);",
                  "    if (claims.sub) pm.collectionVariables.set('recipient_id', claims.sub);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Get tokens (password)",
          "request": {
            "body": {
              "urlencoded": [
                {
                  "value": "password",
                  "type": "text",
                  "key": "grant_type"
                },
                {
                  "value": "{{client_id}}",
                  "type": "text",
                  "key": "client_id"
                },
                {
                  "value": "{{client_secret}}",
                  "type": "text",
                  "key": "client_secret"
                },
                {
                  "value": "{{username}}",
                  "type": "text",
                  "key": "username"
                },
                {
                  "value": "{{password}}",
                  "type": "text",
                  "key": "password"
                }
              ],
              "mode": "urlencoded"
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "value": "application/x-www-form-urlencoded",
                "key": "Content-Type"
              }
            ],
            "method": "POST",
            "url": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token"
          },
          "response": []
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token issued', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const t = pm.response.json();",
                  "  pm.test('Tokens present', () => { pm.expect(t.access_token).to.be.a('string').and.not.empty; pm.expect(t.refresh_token).to.be.a('string').and.not.empty; });",
                  "  if (t.access_token) pm.collectionVariables.set('access_token', t.access_token);",
                  "  if (t.refresh_token) pm.collectionVariables.set('refresh_token', t.refresh_token);",
                  "  if (t.access_token) {",
                  "    const p = t.access_token.split('.')[1].replace(/-/g, '+').replace(/_/g, '/');",
                  "    const claims = JSON.parse(atob(p));",
                  "    if (claims.company_id) pm.collectionVariables.set('company_id', claims.company_id);",
                  "    if (claims.sub) pm.collectionVariables.set('recipient_id', claims.sub);",
                  "  }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "Refresh tokens (run when needed)",
          "request": {
            "body": {
              "urlencoded": [
                {
                  "value": "refresh_token",
                  "type": "text",
                  "key": "grant_type"
                },
                {
                  "value": "{{client_id}}",
                  "type": "text",
                  "key": "client_id"
                },
                {
                  "value": "{{client_secret}}",
                  "type": "text",
                  "key": "client_secret"
                },
                {
                  "value": "{{refresh_token}}",
                  "type": "text",
                  "key": "refresh_token"
                }
              ],
              "mode": "urlencoded"
            },
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "value": "application/x-www-form-urlencoded",
                "key": "Content-Type"
              }
            ],
            "method": "POST",
            "url": "{{keycloak_url}}/realms/{{realm}}/protocol/openid-connect/token"
          },
          "response": []
        }
